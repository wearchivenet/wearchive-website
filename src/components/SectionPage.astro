---
import CallToAction from "@/components/CallToAction.astro";
import StoryCard from "@/components/StoryCard.astro";
import { editorialItems, homeContent, pages } from "@/data/content";
import { localizedPath, type Language, type SectionSlug } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

type Props = {
  language: Language;
  section: SectionSlug;
};

const { language, section } = Astro.props;
const page = pages[language][section];
const home = homeContent[language];
const items = editorialItems[language];
const showServices = section === "astrology" || section === "tarot";
---

<BaseLayout title={`Astra Arcana | ${page.title}`} description={page.excerpt} language={language} section={section}>
  <section class="relative isolate overflow-hidden bg-archive-navy text-white" data-page-hero>
    <div class="pride-aurora absolute -right-20 top-0 h-full w-2/3 opacity-45 blur-3xl"></div>
    <div class="paper-grain absolute inset-0 opacity-20"></div>
    <div class="relative mx-auto grid min-h-[62svh] max-w-[90rem] content-end gap-10 px-5 pb-16 pt-24 sm:px-8 lg:grid-cols-[1fr_0.5fr] lg:px-10 lg:pb-20">
      <div>
        <p class="page-hero-item text-xs uppercase tracking-[0.24em] text-pride-pink">{page.eyebrow}</p>
        <h1 class="page-hero-item mt-6 max-w-5xl font-display text-[clamp(4rem,8vw,8rem)] leading-[0.9]">{page.title}</h1>
        <p class="page-hero-item mt-8 max-w-3xl text-lg leading-9 text-white/65">{page.excerpt}</p>
      </div>
      <div class="page-hero-item self-end border-l border-white/20 pl-6">
        <p class="text-xs uppercase tracking-[0.2em] text-white/35">At a glance</p>
        <ul class="mt-5 grid gap-3 text-sm text-white/70">
          {page.highlights.map((item, index) => (
            <li class="flex gap-3">
              <span class:list={[
                "mt-2 h-2 w-2 shrink-0 rounded-full",
                index === 0 ? "bg-pride-transblue" : index === 1 ? "bg-pride-pink" : "bg-pride-yellow"
              ]}></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="pride-ribbon h-1"></div>
  </section>

  <section class="bg-archive-pale">
    <div class="mx-auto grid max-w-[90rem] gap-14 px-5 py-24 sm:px-8 lg:grid-cols-[0.52fr_1.48fr] lg:px-10 lg:py-32">
      <div data-reveal>
        <p class="text-xs uppercase tracking-[0.22em] text-archive-blue/55">A closer reading</p>
        <div class="mt-6 font-display text-6xl text-pride-violet/25">✦</div>
      </div>
      <div class="max-w-4xl space-y-8" data-reveal>
        {page.body.map((paragraph, index) => (
          <p class:list={[
            "leading-[1.8] text-archive-ink/70",
            index === 0 ? "font-display text-3xl leading-[1.45] text-archive-navy md:text-4xl" : "max-w-2xl text-lg"
          ]}>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  {showServices && (
    <section class="bg-archive-navy text-white">
      <div class="mx-auto max-w-[90rem] px-5 py-24 sm:px-8 lg:px-10 lg:py-32">
        <p class="text-xs uppercase tracking-[0.22em] text-pride-transblue" data-reveal>Available readings</p>
        <h2 class="mt-5 max-w-4xl font-display text-5xl md:text-7xl" data-reveal>
          {language === "zh" ? "選擇你需要的觀看尺度" : language === "fr" ? "Choisir la juste échelle de lecture" : "Choose the scale of attention you need"}
        </h2>
        <div class="mt-16">
          {items.map((item, index) => <StoryCard item={item} index={index} />)}
        </div>
      </div>
    </section>
  )}

  {section === "book" ? (
    <section class="bg-white">
      <div class="mx-auto max-w-[90rem] px-5 py-24 text-center sm:px-8 lg:px-10 lg:py-32" data-reveal>
        <p class="text-xs uppercase tracking-[0.22em] text-archive-blue/55">Booking opens soon</p>
        <h2 class="mx-auto mt-6 max-w-4xl font-display text-5xl leading-[1.05] text-archive-navy md:text-7xl">
          {language === "zh" ? "預約系統建置中，先用一封信開始。" : language === "fr" ? "La réservation arrive bientôt. Commençons par un message." : "Booking is coming soon. Begin with a message."}
        </h2>
        <a href="mailto:hello@astra-arcana.com" class="mt-10 inline-flex min-h-14 items-center bg-archive-navy px-7 py-4 text-sm text-white transition hover:bg-pride-violet">
          hello@astra-arcana.com ↗
        </a>
      </div>
    </section>
  ) : (
    <CallToAction title={home.ctaTitle} text={home.ctaText} button={home.ctaButton} href={localizedPath(language, "book")} />
  )}
</BaseLayout>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);
  const pageHero = document.querySelector("[data-page-hero]");
  const mm = gsap.matchMedia();

  mm.add("(prefers-reduced-motion: no-preference)", () => {
    const intro = gsap.timeline({ defaults: { duration: 0.85, ease: "power3.out" } });
    intro.from(".page-hero-item", { autoAlpha: 0, y: 28, stagger: 0.1 });

    gsap.set("[data-reveal]", { autoAlpha: 0, y: 30 });
    const batches = ScrollTrigger.batch("[data-reveal]", {
      start: "top 88%",
      once: true,
      onEnter: (elements) => gsap.to(elements, { autoAlpha: 1, y: 0, duration: 0.8, stagger: 0.08, ease: "power3.out" })
    });

    if (pageHero) {
      gsap.to(pageHero.querySelector(".pride-aurora"), {
        xPercent: -12,
        yPercent: 8,
        ease: "none",
        scrollTrigger: {
          trigger: pageHero,
          start: "top top",
          end: "bottom top",
          scrub: 0.8
        }
      });
    }

    return () => {
      intro.kill();
      batches.forEach((trigger) => trigger.kill());
    };
  });

  document.fonts.ready.then(() => ScrollTrigger.refresh());
</script>
