---
import { languages, localizedPath, type Language } from "@/lib/i18n";

type Props = {
  language: Language;
  section?: string;
};

const { language, section = "" } = Astro.props;
---

<nav aria-label="Language selector" class="flex items-center gap-1 text-xs uppercase tracking-[0.12em]">
  {Object.values(languages).map((item) => (
    <a
      href={localizedPath(item.code as Language, section)}
      class:list={[
        "px-2 py-2 transition",
        item.code === language
          ? "text-archive-gold"
          : "text-white/45 hover:text-white"
      ]}
      aria-current={item.code === language ? "page" : undefined}
    >
      {item.code}
    </a>
  ))}
</nav>
