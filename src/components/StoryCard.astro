---
import type { EditorialItem } from "@/data/content";

type Props = {
  item: EditorialItem;
};

const { item } = Astro.props;
---

<article class="group border border-slate-200 bg-white">
  <div class="aspect-[4/3] overflow-hidden bg-archive-mist">
    <img src={item.image} alt="" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
  </div>
  <div class="p-6">
    <p class="text-xs uppercase tracking-[0.18em] text-archive-blue">{item.type} · {item.date}</p>
    <h3 class="mt-3 text-2xl leading-tight text-archive-navy">{item.title}</h3>
    <p class="mt-4 leading-7 text-slate-700">{item.excerpt}</p>
  </div>
</article>
