---
import type { EditorialItem } from "@/data/content";

type Props = {
  item: EditorialItem;
  index?: number;
};

const { item, index = 0 } = Astro.props;
---

<article class="service-item group relative border-t border-white/25 py-8 md:grid md:grid-cols-[5rem_1fr_auto] md:items-start md:gap-8" data-reveal>
  <div class="font-display text-5xl text-white/25 transition duration-500 group-hover:scale-110 group-hover:text-pride-pink">
    {item.symbol}
  </div>
  <div class="mt-5 md:mt-0">
    <p class="text-xs uppercase tracking-[0.2em] text-white/40">0{index + 1} · {item.type}</p>
    <h3 class="mt-3 font-display text-3xl text-white md:text-4xl">{item.title}</h3>
    <p class="mt-4 max-w-2xl text-sm leading-7 text-white/55 md:text-base">{item.excerpt}</p>
  </div>
  <p class="mt-6 text-xs uppercase tracking-[0.16em] text-pride-transblue md:mt-1">{item.meta}</p>
</article>
