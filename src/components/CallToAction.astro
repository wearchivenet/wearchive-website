---
type Props = {
  title: string;
  text: string;
  button: string;
  href: string;
};

const { title, text, button, href } = Astro.props;
---

<section class="bg-archive-pale">
  <div class="mx-auto grid max-w-7xl gap-8 px-5 py-16 lg:grid-cols-[1fr_auto] lg:items-center lg:px-8">
    <div class="editorial-rule">
      <h2 class="text-4xl leading-tight text-archive-navy">{title}</h2>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-700">{text}</p>
    </div>
    <a href={href} class="inline-flex min-h-12 items-center justify-center border border-archive-blue bg-archive-blue px-7 py-4 text-white transition hover:bg-archive-navy">
      {button}
    </a>
  </div>
</section>
