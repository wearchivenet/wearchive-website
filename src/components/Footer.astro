---
import { sections, localizedPath, type Language } from "@/lib/i18n";

type Props = {
  language: Language;
};

const { language } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-archive-navy text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 lg:grid-cols-[1.2fr_1fr_1fr] lg:px-8">
    <div>
      <img src="/images/logo.png" alt="We Archive" class="h-12 w-auto bg-white p-2" />
      <p class="mt-6 max-w-md text-lg leading-8 text-slate-200">
        Preserve. Connect. Inspire.
      </p>
      <p class="mt-4 max-w-md text-sm leading-7 text-slate-300">
        International cultural preservation, public archives, and educational resources.
      </p>
    </div>
    <nav aria-label="Footer navigation" class="grid gap-3">
      <h2 class="text-sm uppercase tracking-[0.18em] text-archive-gold">Navigation</h2>
      {sections.map((item) => (
        <a href={localizedPath(language, item.slug)} class="font-kai text-slate-100 hover:text-archive-gold">
          {item.label}
        </a>
      ))}
    </nav>
    <div>
      <h2 class="text-sm uppercase tracking-[0.18em] text-archive-gold">Contact</h2>
      <address class="mt-4 not-italic leading-7 text-slate-200">
        We Archive Foundation<br />
        contact@we-archive.org<br />
        Paris · Taipei · Online
      </address>
      <div class="mt-6 flex gap-4 text-sm uppercase tracking-[0.16em]">
        <a href="https://www.instagram.com/" class="hover:text-archive-gold">Instagram</a>
        <a href="https://www.linkedin.com/" class="hover:text-archive-gold">LinkedIn</a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/15 px-5 py-5 text-center text-sm text-slate-300">
    © {year} We Archive. All rights reserved.
  </div>
</footer>
