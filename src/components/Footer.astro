---
import { sections, sectionLabel, localizedPath, type Language } from "@/lib/i18n";

type Props = {
  language: Language;
};

const { language } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="bg-archive-navy text-white">
  <div class="mx-auto grid max-w-[90rem] gap-12 px-5 py-16 lg:grid-cols-[1.35fr_0.8fr_0.8fr] lg:px-10">
    <div>
      <div class="font-display text-3xl tracking-[0.14em] text-archive-gold">ASTRA ARCANA</div>
      <p class="mt-6 max-w-md font-display text-2xl leading-8 text-white">
        讓星圖成為語言，讓塔羅照見此刻。
      </p>
      <p class="mt-4 max-w-md text-sm leading-7 text-white/55">
        Astrology and tarot consultations for self-understanding, relationship insight, and the seasons of change.
      </p>
    </div>
    <nav aria-label="Footer navigation" class="grid gap-3">
      <h2 class="text-xs uppercase tracking-[0.2em] text-archive-gold">Explore</h2>
      {sections.map((item) => (
        <a href={localizedPath(language, item.slug)} class="text-sm text-white/65 hover:text-archive-gold">
          {sectionLabel(language, item.slug)}
        </a>
      ))}
    </nav>
    <div>
      <h2 class="text-xs uppercase tracking-[0.2em] text-archive-gold">Contact</h2>
      <address class="mt-4 not-italic text-sm leading-7 text-white/65">
        Online consultations<br />
        hello@astra-arcana.com<br />
        Paris · Taipei · Worldwide
      </address>
      <div class="mt-6 flex gap-4 text-sm uppercase tracking-[0.16em]">
        <a href="https://www.instagram.com/" class="hover:text-archive-gold">Instagram</a>
        <a href={localizedPath(language, "book")} class="hover:text-archive-gold">Booking</a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/15 px-5 py-5 text-center text-sm text-slate-300">
    © {year} Astra Arcana. All rights reserved.
  </div>
</footer>
