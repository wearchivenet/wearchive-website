---
type Props = {
  eyebrow?: string;
  title: string;
  text?: string;
  light?: boolean;
};

const { eyebrow, title, text, light = false } = Astro.props;
---

<div class="max-w-4xl" data-reveal>
  <div class="mb-6 flex items-center gap-4">
    <span class="h-px w-12 bg-pride-pink"></span>
    {eyebrow && <p class:list={["text-xs uppercase tracking-[0.22em]", light ? "text-white/50" : "text-archive-blue/70"]}>{eyebrow}</p>}
  </div>
  <h2 class:list={["font-display text-4xl leading-[1.05] md:text-6xl lg:text-7xl", light ? "text-white" : "text-archive-navy"]}>{title}</h2>
  {text && <p class:list={["mt-6 max-w-2xl text-base leading-8 md:text-lg", light ? "text-white/55" : "text-archive-ink/65"]}>{text}</p>}
</div>
